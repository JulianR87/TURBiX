<UserControl x:Class="Turbix.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Turbix.Controls"
             xmlns:l="clr-namespace:Turbix.Localization">
  <Grid Margin="40,8,40,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="{l:T nav.apps}" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,16" TextWrapping="Wrap"
                 Text="{l:T apps.subtitle}"/>
    </StackPanel>

    <Border Grid.Row="1" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
            CornerRadius="10" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="TabStoreButton" Style="{StaticResource SegmentItem}" GroupName="AppsTab" Height="34" FontSize="13"
                     MinWidth="190" Padding="18,0" Tag="&#xE719;" Content="{l:T apps.tab.store}" IsChecked="True" Checked="OnTab"/>
        <RadioButton x:Name="TabProgramsButton" Style="{StaticResource SegmentItem}" GroupName="AppsTab" Height="34" FontSize="13"
                     MinWidth="200" Padding="18,0" Tag="&#xE71D;" Content="{l:T apps.tab.programs}" Checked="OnTab"/>
      </StackPanel>
    </Border>

    <!-- ============================================================ Apps de Windows -->
    <Grid x:Name="TabStore" Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Background="{DynamicResource NoteBg}" BorderBrush="{DynamicResource NoteStroke}" BorderThickness="1" CornerRadius="10"
              Padding="14,11" Margin="0,0,0,14">
        <DockPanel>
          <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{DynamicResource AccentText}" VerticalAlignment="Top" Margin="0,1,12,0"/>
          <TextBlock Style="{StaticResource Muted}" Foreground="{DynamicResource NoteText}" FontSize="12.5"
                     TextWrapping="Wrap" Text="{l:T apps.store.note}"/>
        </DockPanel>
      </Border>

      <DockPanel Grid.Row="1" Margin="0,0,0,12">
        <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Command="{Binding RefreshAppsCommand}" Margin="0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12"/>
            <TextBlock Text="{l:T common.refresh}" Margin="8,0,0,0"/>
          </StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{l:T common.quickSelect}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12.5"/>
          <Button Style="{StaticResource PillButton}" Content="{l:T common.recommended}" Command="{Binding SelectAppsPresetCommand}" CommandParameter="recommended"/>
          <Button Style="{StaticResource PillButton}" Content="{l:T common.all}" Command="{Binding SelectAppsPresetCommand}" CommandParameter="all"/>
          <Button Style="{StaticResource PillButton}" Content="{l:T common.none}" Command="{Binding SelectAppsPresetCommand}" CommandParameter="none"/>
          <c:HelpTip Margin="4,0,0,0" Text="{l:T apps.store.presetHelp}"/>
        </StackPanel>
      </DockPanel>

      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,10,0" Margin="0,0,-10,0">
        <StackPanel>
          <TextBlock Text="{Binding AppsSummary}" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="2,0,0,10" TextWrapping="Wrap"/>
          <ItemsControl ItemsSource="{Binding BloatApps}" Focusable="False" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource RowCard}">
                  <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding ToggleCommand}"/>
                  </Border.InputBindings>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                        <Border Style="{StaticResource Chip}" Background="{DynamicResource WarningSoft}" Margin="10,0,0,0" Padding="6,1"
                                Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVis}}">
                          <TextBlock Text="{l:T common.optional}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Warning}"/>
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,2,0,0"/>
                      <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource Warning}" TextWrapping="Wrap"
                                 Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                        <Run FontFamily="{StaticResource IconFont}" Text="&#xE7BA;"/><Run Text="  "/><Run Text="{Binding Warning, Mode=OneWay}"/>
                      </TextBlock>
                    </StackPanel>
                    <c:HelpTip Grid.Column="2" Margin="14,0,0,0" Text="{Binding Help}" Title="{Binding Name}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="3" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="0,16,0,20" Margin="0,4,0,0">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding RemoveAppsCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14"/>
              <TextBlock Text="{Binding RemoveAppsButtonText}" Margin="10,0,0,0"/>
            </StackPanel>
          </Button>
          <TextBlock Text="{l:T apps.store.footer}"
                     Foreground="{DynamicResource TextDim}" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ============================================================ Programas instalados -->
    <Grid x:Name="TabPrograms" Grid.Row="2" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <DockPanel Margin="0,0,0,12">
        <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Command="{Binding RefreshProgramsCommand}" Margin="10,0,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12"/>
            <TextBlock Text="{l:T common.refresh}" Margin="8,0,0,0"/>
          </StackPanel>
        </Button>
        <c:HelpTip DockPanel.Dock="Right" Margin="10,0,0,0" Text="{l:T apps.programs.help}"/>
        <TextBox DockPanel.Dock="Right" Style="{StaticResource SearchBox}" Width="260" Height="34" Tag="{l:T apps.programs.search}"
                 Text="{Binding ProgramFilter, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="{Binding ProgramsSummary}" Foreground="{DynamicResource TextMuted}" FontSize="13" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Margin="2,0,12,0"/>
      </DockPanel>

      <ListBox Grid.Row="1" ItemsSource="{Binding ProgramsView}" Background="Transparent" BorderThickness="0" Padding="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
               VirtualizingPanel.IsVirtualizing="True" Margin="0,0,-10,0">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <ContentPresenter/>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource RowCard}" Cursor="Arrow" Padding="14,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconTile}" Background="{DynamicResource Surface2}" Margin="0,0,14,0">
                  <Grid>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}"
                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                    <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{DynamicResource TextMuted}" FontSize="12.5"
                           VerticalAlignment="Center" Margin="16,0,16,0" MinWidth="64" TextAlignment="Right"/>
                <Button Grid.Column="3" Content="{l:T apps.programs.uninstall}" Command="{Binding UninstallCommand}" Padding="14,6" FontSize="12.5" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>
