<UserControl x:Class="Turbix.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Turbix.Controls"
             xmlns:l="clr-namespace:Turbix.Localization">
  <UserControl.Resources>
    <!-- Fila de un ajuste: texto a la izquierda, control y «?» a la derecha. Entre filas, una línea fina. -->
    <Style x:Key="SettingRow" TargetType="Grid">
      <Setter Property="Margin" Value="0,14,0,0"/>
    </Style>
    <Style x:Key="SettingDivider" TargetType="Border">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource Stroke}"/>
      <Setter Property="Margin" Value="0,14,0,0"/>
    </Style>
    <Style x:Key="SettingTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SettingText" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SectionIcon" TargetType="Border" BasedOn="{StaticResource IconTile}">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
      <Setter Property="Margin" Value="0,0,14,0"/>
    </Style>
    <!-- Opción del selector de idioma: como las del tema, pero sin icono -->
    <Style x:Key="LangItem" TargetType="RadioButton" BasedOn="{StaticResource SegmentItem}">
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="7" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StrokeStrong}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="40,8,40,32" MaxWidth="900" HorizontalAlignment="Stretch">
      <TextBlock Text="{l:T settings.title}" Style="{StaticResource H1}"/>
      <TextBlock Text="{l:T settings.subtitle}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,18"/>

      <!-- ============================================================ Apariencia e idioma -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel>
            <Border Style="{StaticResource SectionIcon}">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE790;" HorizontalAlignment="Center" Foreground="{DynamicResource AccentText}"/>
            </Border>
            <TextBlock Text="{l:T settings.section.look}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
          </DockPanel>

          <Grid Style="{StaticResource SettingRow}" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
              <TextBlock Text="{l:T settings.theme.title}" Style="{StaticResource SettingTitle}"/>
              <TextBlock Text="{l:T settings.theme.text}" Style="{StaticResource SettingText}"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                    CornerRadius="9" Padding="2" VerticalAlignment="Center" MinWidth="330">
              <UniformGrid Columns="3">
                <RadioButton x:Name="ThemeSystem" Style="{StaticResource SegmentItem}" GroupName="Theme" Tag="&#xE7F4;" Content="{l:T theme.system}" Checked="OnThemeChoice" Padding="10,0"/>
                <RadioButton x:Name="ThemeLight" Style="{StaticResource SegmentItem}" GroupName="Theme" Tag="&#xE706;" Content="{l:T theme.light}" Checked="OnThemeChoice" Padding="10,0"/>
                <RadioButton x:Name="ThemeDark" Style="{StaticResource SegmentItem}" GroupName="Theme" Tag="&#xE708;" Content="{l:T theme.dark}" Checked="OnThemeChoice" Padding="10,0"/>
              </UniformGrid>
            </Border>
          </Grid>

          <Border Style="{StaticResource SettingDivider}"/>

          <Grid Style="{StaticResource SettingRow}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
              <TextBlock Text="{l:T settings.language.title}" Style="{StaticResource SettingTitle}"/>
              <TextBlock Text="{l:T settings.language.text}" Style="{StaticResource SettingText}"/>
            </StackPanel>
            <c:HelpTip Grid.Column="1" VerticalAlignment="Top" Title="{l:T settings.language.title}" Text="{l:T settings.language.help}"/>
          </Grid>
          <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                  CornerRadius="9" Padding="2" Margin="0,12,0,0">
            <ItemsControl ItemsSource="{Binding LanguageOptions}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton Style="{StaticResource LangItem}" GroupName="Language" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <Border Background="{DynamicResource AccentSoft}" CornerRadius="9" Padding="14,10" Margin="0,12,0,0"
                  Visibility="{Binding LanguageNeedsRestart, Converter={StaticResource BoolToVis}}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding RestartCommand}" Margin="14,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13"/>
                  <TextBlock Text="{l:T settings.language.restart}" Margin="10,0,0,0"/>
                </StackPanel>
              </Button>
              <TextBlock Text="{l:T settings.language.restartNote}" TextWrapping="Wrap" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextBody}" FontSize="12.5"/>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- ============================================================ Inicio y segundo plano -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <DockPanel>
            <Border Style="{StaticResource SectionIcon}">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" HorizontalAlignment="Center" Foreground="{DynamicResource AccentText}"/>
            </Border>
            <TextBlock Text="{l:T settings.section.background}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
          </DockPanel>

          <Grid Style="{StaticResource SettingRow}" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
              <TextBlock Text="{l:T startup.self.title}" Style="{StaticResource SettingTitle}"/>
              <TextBlock Text="{l:T startup.self.detail}" Style="{StaticResource SettingText}"/>
            </StackPanel>
            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Margin="0,0,14,0"/>
            <c:HelpTip Grid.Column="2" VerticalAlignment="Center" Title="{l:T startup.self.title}" Text="{l:T startup.self.help}"/>
          </Grid>

          <Border Style="{StaticResource SettingDivider}"/>

          <Grid Style="{StaticResource SettingRow}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
              <TextBlock Text="{l:T settings.tray.title}" Style="{StaticResource SettingTitle}"/>
              <TextBlock Text="{l:T settings.tray.text}" Style="{StaticResource SettingText}"/>
            </StackPanel>
            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowTrayIcon, Mode=TwoWay}" Margin="0,0,14,0"/>
            <c:HelpTip Grid.Column="2" VerticalAlignment="Center" Title="{l:T settings.tray.title}" Text="{l:T settings.tray.help}"/>
          </Grid>

          <Border Style="{StaticResource SettingDivider}"/>

          <Grid Style="{StaticResource SettingRow}" IsEnabled="{Binding ShowTrayIcon}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
              <TextBlock Text="{l:T settings.closeToTray.title}" Style="{StaticResource SettingTitle}"/>
              <TextBlock>
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource SettingText}">
                    <Setter Property="Text" Value="{l:T settings.closeToTray.text}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ShowTrayIcon}" Value="False">
                        <Setter Property="Text" Value="{l:T settings.closeToTray.needsIcon}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CloseToTray, Mode=TwoWay}" Margin="0,0,14,0"/>
            <c:HelpTip Grid.Column="2" VerticalAlignment="Center" Title="{l:T settings.closeToTray.title}" Text="{l:T settings.closeToTray.help}"/>
          </Grid>

          <Border Style="{StaticResource SettingDivider}"/>

          <Grid Style="{StaticResource SettingRow}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
              <TextBlock Text="{l:T settings.confirmExit.title}" Style="{StaticResource SettingTitle}"/>
              <TextBlock Text="{l:T settings.confirmExit.text}" Style="{StaticResource SettingText}"/>
            </StackPanel>
            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ConfirmExit, Mode=TwoWay}" Margin="0,0,14,0"/>
            <c:HelpTip Grid.Column="2" VerticalAlignment="Center" Title="{l:T settings.confirmExit.title}" Text="{l:T settings.confirmExit.help}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ============================================================ Memoria RAM -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <DockPanel>
            <Border Style="{StaticResource SectionIcon}">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE964;" HorizontalAlignment="Center" Foreground="{DynamicResource AccentText}"/>
            </Border>
            <TextBlock Text="{l:T settings.section.memory}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
          </DockPanel>

          <Grid Style="{StaticResource SettingRow}" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
              <TextBlock Text="{l:T memory.auto.enable}" Style="{StaticResource SettingTitle}"/>
              <TextBlock Text="{Binding AutoRamStatus}" Style="{StaticResource SettingText}"/>
            </StackPanel>
            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoRamEnabled, Mode=TwoWay}" Margin="0,0,14,0"/>
            <c:HelpTip Grid.Column="2" VerticalAlignment="Center" Title="{l:T memory.auto.title}" Text="{l:T memory.auto.help}"/>
          </Grid>

          <StackPanel IsEnabled="{Binding AutoRamEnabled}">
            <Border Style="{StaticResource SettingDivider}"/>
            <Grid Style="{StaticResource SettingRow}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{l:T settings.memory.interval}" Style="{StaticResource SettingTitle}" VerticalAlignment="Center" Margin="0,0,20,0"/>
              <Border Grid.Column="1" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                      CornerRadius="9" Padding="2" Margin="0,0,14,0" MinWidth="330">
                <UniformGrid x:Name="IntervalOptions" Columns="5">
                  <RadioButton Style="{StaticResource SegmentItem}" GroupName="SettingsRamInterval" CommandParameter="5" Content="{l:T memory.interval.m5}" Checked="OnInterval"/>
                  <RadioButton Style="{StaticResource SegmentItem}" GroupName="SettingsRamInterval" CommandParameter="10" Content="{l:T memory.interval.m10}" Checked="OnInterval"/>
                  <RadioButton Style="{StaticResource SegmentItem}" GroupName="SettingsRamInterval" CommandParameter="15" Content="{l:T memory.interval.m15}" Checked="OnInterval"/>
                  <RadioButton Style="{StaticResource SegmentItem}" GroupName="SettingsRamInterval" CommandParameter="30" Content="{l:T memory.interval.m30}" Checked="OnInterval"/>
                  <RadioButton Style="{StaticResource SegmentItem}" GroupName="SettingsRamInterval" CommandParameter="60" Content="{l:T memory.interval.h1}" Checked="OnInterval"/>
                </UniformGrid>
              </Border>
              <c:HelpTip Grid.Column="2" VerticalAlignment="Center" Title="{l:T settings.memory.interval}" Text="{l:T memory.auto.interval.help}"/>
            </Grid>

            <Border Style="{StaticResource SettingDivider}"/>
            <Grid Style="{StaticResource SettingRow}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{l:T memory.auto.onlyHigh}" Style="{StaticResource SettingTitle}" VerticalAlignment="Center" Margin="0,0,20,0"/>
              <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoRamOnlyHigh, Mode=TwoWay}" Margin="0,0,14,0"/>
              <c:HelpTip Grid.Column="2" VerticalAlignment="Center" Title="{l:T memory.auto.onlyHigh}" Text="{l:T memory.auto.onlyHigh.help}"/>
            </Grid>

            <Border Style="{StaticResource SettingDivider}"/>
            <Grid Style="{StaticResource SettingRow}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{l:T memory.auto.notify}" Style="{StaticResource SettingTitle}" VerticalAlignment="Center" Margin="0,0,20,0"/>
              <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoRamNotify, Mode=TwoWay}" Margin="0,0,14,0"/>
              <c:HelpTip Grid.Column="2" VerticalAlignment="Center" Title="{l:T memory.auto.notify}" Text="{l:T memory.auto.notify.help}"/>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ============================================================ Datos -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <DockPanel>
            <Border Style="{StaticResource SectionIcon}">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" HorizontalAlignment="Center" Foreground="{DynamicResource AccentText}"/>
            </Border>
            <TextBlock Text="{l:T settings.section.data}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
          </DockPanel>

          <Grid Style="{StaticResource SettingRow}" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
              <TextBlock Text="{l:T settings.data.title}" Style="{StaticResource SettingTitle}"/>
              <TextBlock Text="{Binding DataFolder, Mode=OneTime}" Style="{StaticResource SettingText}" FontFamily="{StaticResource MonoFont}"
                         TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding OpenDataFolderCommand}" Padding="14,7" FontSize="12.5" Margin="0,0,14,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12"/>
                <TextBlock Text="{l:T settings.data.open}" Margin="8,0,0,0"/>
              </StackPanel>
            </Button>
            <c:HelpTip Grid.Column="2" VerticalAlignment="Center" Title="{l:T settings.data.title}" Text="{l:T settings.data.help}"/>
          </Grid>

          <Border Style="{StaticResource SettingDivider}"/>

          <Grid Style="{StaticResource SettingRow}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
              <TextBlock Text="{l:T settings.reset.title}" Style="{StaticResource SettingTitle}"/>
              <TextBlock Text="{l:T settings.reset.text}" Style="{StaticResource SettingText}"/>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding ResetSettingsCommand}" Padding="14,7" FontSize="12.5" Margin="0,0,14,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="12"/>
                <TextBlock Text="{l:T settings.reset.button}" Margin="8,0,0,0"/>
              </StackPanel>
            </Button>
            <c:HelpTip Grid.Column="2" VerticalAlignment="Center" Title="{l:T settings.reset.title}" Text="{l:T settings.reset.help}"/>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
