<UserControl x:Class="Turbix.Views.PrivacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Turbix.Controls"
             xmlns:l="clr-namespace:Turbix.Localization">
  <UserControl.Resources>
    <DataTemplate x:Key="TweakRow">
      <Border Style="{StaticResource RowCard}">
        <Border.InputBindings>
          <MouseBinding Gesture="LeftClick" Command="{Binding ToggleCommand}"/>
        </Border.InputBindings>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,16,0"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
              <Border Style="{StaticResource Chip}" Background="{DynamicResource WarningSoft}" Margin="10,0,0,0" Padding="6,1"
                      Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{l:T common.advanced}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Warning}"/>
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,2,0,0"/>
            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource Warning}" TextWrapping="Wrap"
                       Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
              <Run FontFamily="{StaticResource IconFont}" Text="&#xE7BA;"/><Run Text="  "/><Run Text="{Binding Warning, Mode=OneWay}"/>
            </TextBlock>
          </StackPanel>
          <Border Grid.Column="2" Style="{StaticResource StateChip}" Margin="16,0,14,0" MinWidth="92">
            <TextBlock Text="{Binding StateText}" Style="{StaticResource StateChipText}" HorizontalAlignment="Center"/>
          </Border>
          <c:HelpTip Grid.Column="3" Text="{Binding Help}" Title="{Binding Name}"/>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="40,8,40,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="{l:T privacy.title}" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,18"
                 Text="{l:T privacy.subtitle}"/>
    </StackPanel>

    <!-- Aviso por edición -->
    <Border Grid.Row="1" Background="{DynamicResource NoteBg}" BorderBrush="{DynamicResource NoteStroke}" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,0,0,14"
            Visibility="{Binding HasEditionNote, Converter={StaticResource BoolToVis}}">
      <DockPanel>
        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{DynamicResource AccentText}" VerticalAlignment="Top" Margin="0,1,12,0"/>
        <TextBlock Text="{Binding EditionNote}" Style="{StaticResource Muted}" Foreground="{DynamicResource NoteText}" FontSize="12.5"/>
      </DockPanel>
    </Border>

    <!-- Barra de selección -->
    <DockPanel Grid.Row="2" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Command="{Binding RefreshStatesCommand}" Margin="0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12"/>
          <TextBlock Text="{l:T common.refreshState}" Margin="8,0,0,0"/>
        </StackPanel>
      </Button>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{l:T common.quickSelect}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12.5"/>
        <Button Style="{StaticResource PillButton}" Content="{l:T common.recommended}" Command="{Binding SelectTweakPresetCommand}" CommandParameter="recommended"/>
        <Button Style="{StaticResource PillButton}" Content="{l:T common.maximum}" Command="{Binding SelectTweakPresetCommand}" CommandParameter="max"/>
        <Button Style="{StaticResource PillButton}" Content="{l:T common.none}" Command="{Binding SelectTweakPresetCommand}" CommandParameter="none"/>
        <c:HelpTip Margin="4,0,0,0" Text="{l:T privacy.preset.help}"/>
      </StackPanel>
    </DockPanel>

    <!-- Lista -->
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,10,0" Margin="0,0,-10,0">
      <ItemsControl ItemsSource="{Binding TweakGroups}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,14">
              <StackPanel Orientation="Horizontal" Margin="2,4,0,10">
                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13" Foreground="{DynamicResource AccentText}"/>
                <TextBlock Text="{Binding Name, Converter={StaticResource Upper}}" Style="{StaticResource Caption}" FontSize="11.5"
                           Foreground="{DynamicResource TextMuted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" FontWeight="Normal" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <c:HelpTip Text="{Binding Help}" Width="18" Height="18" Margin="10,0,0,0"/>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TweakRow}" Focusable="False"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Pie de acción -->
    <Border Grid.Row="4" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="0,16,0,20" Margin="0,4,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyTweaksCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="14" />
            <TextBlock Text="{Binding ApplyButtonText}" Margin="10,0,0,0"/>
          </StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox IsChecked="{Binding CreateRestorePoint}" Content="{l:T privacy.restorePoint}"/>
          <c:HelpTip Margin="10,0,0,0" Text="{l:T privacy.restorePoint.help}"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
