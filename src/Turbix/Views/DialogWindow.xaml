<Window x:Class="Turbix.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Turbix.Localization"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="Height" Width="480"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="13.5" Foreground="{DynamicResource Text}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
  <Border Margin="18" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource StrokeStrong}"
          BorderThickness="1" CornerRadius="14" MouseLeftButtonDown="OnDrag">
    <Border.Effect>
      <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.3" Color="Black"/>
    </Border.Effect>
    <StackPanel Margin="26,24,26,22">
      <StackPanel Orientation="Horizontal">
        <Border x:Name="IconTile" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoft}">
          <TextBlock x:Name="IconGlyph" Style="{StaticResource Icon}" FontSize="19" HorizontalAlignment="Center"
                     Foreground="{DynamicResource AccentText}" Text="&#xE946;"/>
        </Border>
        <TextBlock x:Name="TitleText" Style="{StaticResource H2}" FontSize="17" Margin="14,0,0,0"
                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="340"/>
      </StackPanel>
      <TextBlock x:Name="MessageText" Style="{StaticResource Muted}" FontSize="13.5" LineHeight="21"
                 Foreground="{DynamicResource TextBody}" Margin="0,16,0,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
        <Button x:Name="CancelButton" Content="{l:T common.cancel}" IsCancel="True" Margin="0,0,10,0" Click="OnCancel"/>
        <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Content="{l:T common.ok}" IsDefault="True" Click="OnOk"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
