<UserControl x:Class="Turbix.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Turbix.Controls"
             xmlns:l="clr-namespace:Turbix.Localization"
             x:Name="Self">
  <Grid Margin="40,8,40,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="{l:T nav.restore}" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,18"
                 Text="{l:T restore.subtitle}"/>
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="18,16">
        <DockPanel>
          <Border Style="{StaticResource IconTile}"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" HorizontalAlignment="Center" Foreground="{DynamicResource AccentText}"/></Border>
          <Button DockPanel.Dock="Right" Content="{l:T restore.openFolder}" Command="{Binding OpenBackupsCommand}" Padding="14,6" FontSize="12.5" VerticalAlignment="Center"/>
          <StackPanel Margin="14,0,12,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{l:T restore.backups.title}" FontWeight="SemiBold"/>
              <c:HelpTip Width="18" Height="18" Margin="8,0,0,0" Title="{l:T restore.backups.title}" Text="{l:T restore.backups.help}"/>
            </StackPanel>
            <TextBlock Text="{l:T restore.backups.text}" Style="{StaticResource Muted}" FontSize="12.5"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16">
        <DockPanel>
          <Border Style="{StaticResource IconTile}"><TextBlock Style="{StaticResource Icon}" Text="&#xE777;" HorizontalAlignment="Center" Foreground="{DynamicResource AccentText}"/></Border>
          <Button DockPanel.Dock="Right" Content="{l:T common.open}" Command="{Binding OpenSystemRestoreCommand}" Padding="14,6" FontSize="12.5" VerticalAlignment="Center"/>
          <StackPanel Margin="14,0,12,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{l:T restore.system.title}" FontWeight="SemiBold"/>
              <c:HelpTip Width="18" Height="18" Margin="8,0,0,0" Title="{l:T restore.system.title}" Text="{l:T restore.system.help}"/>
            </StackPanel>
            <TextBlock Text="{l:T restore.system.text}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <DockPanel Margin="2,0,0,10">
        <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Command="{Binding RefreshBackupsCommand}" Margin="0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12"/>
            <TextBlock Text="{l:T common.refresh}" Margin="8,0,0,0"/>
          </StackPanel>
        </Button>
        <TextBlock Text="{l:T restore.history}" Style="{StaticResource Caption}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
      </DockPanel>

      <!-- Vacío -->
      <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="28"
              Visibility="{Binding HasBackups, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="30" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"/>
          <TextBlock Text="{l:T restore.empty.title}" FontWeight="SemiBold" FontSize="14.5" HorizontalAlignment="Center" Margin="0,12,0,4"/>
          <TextBlock Text="{l:T restore.empty.text}" Style="{StaticResource Muted}" TextAlignment="Center"/>
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,10,0" Margin="0,0,-10,0">
        <ItemsControl ItemsSource="{Binding Backups}" Focusable="False" Margin="0,0,0,20">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}" Background="{DynamicResource Surface2}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                      <Border Style="{StaticResource Chip}" Background="{DynamicResource SuccessSoft}" Margin="10,0,0,0" Padding="6,1"
                              Visibility="{Binding IsReverted, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{l:T restore.reverted}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Success}"/>
                      </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12.5">
                      <Run Text="{Binding DateText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Details, Mode=OneWay}"/>
                    </TextBlock>
                  </StackPanel>
                  <Button Grid.Column="2" Content="{l:T restore.revert}" Padding="16,7" VerticalAlignment="Center"
                          Command="{Binding DataContext.RevertCommand, ElementName=Self}" CommandParameter="{Binding}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
