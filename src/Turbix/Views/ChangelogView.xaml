<UserControl x:Class="Turbix.Views.ChangelogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Turbix.Controls"
             xmlns:l="clr-namespace:Turbix.Localization">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="40,8,40,32" MaxWidth="980" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{l:T nav.changelog}" Style="{StaticResource H1}"/>
        <c:HelpTip Margin="12,4,0,0" Title="{l:T nav.changelog}" Text="{l:T whatsnew.help}"/>
      </StackPanel>
      <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,26" Text="{Binding ChangelogSubtitle}"/>

      <ItemsControl ItemsSource="{Binding Releases}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- Versión y fecha -->
              <StackPanel Margin="0,14,0,0">
                <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold">
                  <Run Text="v" Foreground="{DynamicResource TextDim}"/><Run Text="{Binding Version, Mode=OneWay}"/>
                </TextBlock>
                <Border Style="{StaticResource Chip}" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Padding="7,2" Margin="0,6,0,0"
                        Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="{l:T whatsnew.installed}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentInk}"/>
                </Border>
              </StackPanel>

              <!-- Línea de tiempo -->
              <Grid Grid.Column="1">
                <Rectangle Width="1" Fill="{DynamicResource StrokeStrong}" HorizontalAlignment="Center">
                  <Rectangle.Style>
                    <Style TargetType="Rectangle">
                      <Setter Property="Margin" Value="0,0,0,0"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFirst}" Value="True">
                          <Setter Property="Margin" Value="0,24,0,0"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Rectangle.Style>
                </Rectangle>
                <Border Width="11" Height="11" CornerRadius="3" VerticalAlignment="Top" Margin="0,22,0,0" BorderThickness="2"
                        BorderBrush="{DynamicResource Bg}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{DynamicResource StrokeStrong}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource NavIndicator}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                </Border>
              </Grid>

              <!-- Cambios -->
              <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,18,22,6" Margin="0,0,0,18">
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,0,0,14">
                        <Rectangle Width="6" Height="6" Fill="{DynamicResource NavIndicator}" VerticalAlignment="Top" Margin="0,7,14,0"/>
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"
                                     Visibility="{Binding HasTitle, Converter={StaticResource BoolToVis}}"/>
                          <TextBlock Text="{Binding Text}" Style="{StaticResource Muted}" Margin="0,2,0,0"
                                     Visibility="{Binding HasText, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
