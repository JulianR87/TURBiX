<UserControl x:Class="Turbix.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Turbix.Controls"
             xmlns:l="clr-namespace:Turbix.Localization">
  <UserControl.Resources>
    <!-- Fondo y color según el nivel: Good, Attention, Problem, Unknown -->
    <Style x:Key="LevelBack" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ChipNeutral}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding LevelKey}" Value="Good"><Setter Property="Background" Value="{DynamicResource SuccessSoft}"/></DataTrigger>
        <DataTrigger Binding="{Binding LevelKey}" Value="Attention"><Setter Property="Background" Value="{DynamicResource WarningSoft}"/></DataTrigger>
        <DataTrigger Binding="{Binding LevelKey}" Value="Problem"><Setter Property="Background" Value="{DynamicResource DangerSoft}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LevelText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding LevelKey}" Value="Good"><Setter Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
        <DataTrigger Binding="{Binding LevelKey}" Value="Attention"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger>
        <DataTrigger Binding="{Binding LevelKey}" Value="Problem"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="40,8,40,32">
      <TextBlock Text="{l:T nav.health}" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,18"
                 Text="{l:T health.subtitle}"/>

      <!-- Resumen -->
      <Border Style="{StaticResource Card}" Padding="22,16" Margin="0,0,0,16">
        <DockPanel>
          <c:HelpTip DockPanel.Dock="Right" Text="{l:T health.summary.help}" Title="{l:T nav.health}"/>
          <Button DockPanel.Dock="Right" Command="{Binding RefreshHealthCommand}" Padding="14,7" FontSize="12.5" Margin="0,0,14,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12"/>
              <TextBlock Text="{l:T health.rescan}" Margin="8,0,0,0"/>
            </StackPanel>
          </Button>
          <StackPanel Orientation="Horizontal">
            <Border Width="46" Height="46" CornerRadius="12">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource ChipNeutral}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HealthLevelKey}" Value="Good"><Setter Property="Background" Value="{DynamicResource SuccessSoft}"/></DataTrigger>
                    <DataTrigger Binding="{Binding HealthLevelKey}" Value="Attention"><Setter Property="Background" Value="{DynamicResource WarningSoft}"/></DataTrigger>
                    <DataTrigger Binding="{Binding HealthLevelKey}" Value="Problem"><Setter Property="Background" Value="{DynamicResource DangerSoft}"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE95E;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HealthLevelKey}" Value="Good"><Setter Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
                      <DataTrigger Binding="{Binding HealthLevelKey}" Value="Attention"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger>
                      <DataTrigger Binding="{Binding HealthLevelKey}" Value="Problem"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Border>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{l:T health.summary.caption}" Style="{StaticResource Caption}"/>
              <TextBlock Text="{Binding HealthSummary}" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,0"/>
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Componentes -->
      <ItemsControl ItemsSource="{Binding HealthItems}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,10">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}" Background="{DynamicResource Surface2}" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Headline}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,2,0,0"/>
                  </StackPanel>
                  <Border Grid.Column="2" Style="{StaticResource LevelBack}" CornerRadius="6" Padding="10,3" Margin="16,0,14,0" MinWidth="84" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LevelText}" Style="{StaticResource LevelText}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  </Border>
                  <c:HelpTip Grid.Column="3" Text="{Binding Help}" Title="{Binding Name}"/>
                </Grid>

                <!-- Qué hacer -->
                <Border Style="{StaticResource LevelBack}" CornerRadius="8" Padding="12,9" Margin="50,12,0,0"
                        Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="{Binding Advice}" Style="{StaticResource LevelText}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"/>
                </Border>

                <!-- Datos -->
                <ItemsControl ItemsSource="{Binding Details}" Focusable="False" Margin="50,12,0,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="{Binding DetailColumns}"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,0,24,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   MaxWidth="320" TextAlignment="Right"/>
                        <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
