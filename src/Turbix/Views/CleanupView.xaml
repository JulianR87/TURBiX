<UserControl x:Class="Turbix.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Turbix.Controls"
             xmlns:v="clr-namespace:Turbix.Views"
             xmlns:l="clr-namespace:Turbix.Localization">
  <UserControl.Resources>
    <v:CleanupPluralConverter x:Key="Plural"/>
    <DataTemplate x:Key="CleanRow">
      <Border Style="{StaticResource RowCard}">
        <Border.InputBindings>
          <MouseBinding Gesture="LeftClick" Command="{Binding ToggleCommand}"/>
        </Border.InputBindings>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,16,0"/>
          <Border Grid.Column="1" Style="{StaticResource IconTile}" Margin="0,0,14,0">
            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" HorizontalAlignment="Center" Foreground="{DynamicResource AccentText}"/>
          </Border>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
              <Border Style="{StaticResource Chip}" Background="{DynamicResource WarningSoft}" Margin="10,0,0,0" Padding="6,1"
                      Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{l:T common.optional}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Warning}"/>
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,2,0,0"/>
            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource Warning}" TextWrapping="Wrap"
                       Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
              <Run FontFamily="{StaticResource IconFont}" Text="&#xE7BA;"/><Run Text="  "/><Run Text="{Binding Warning, Mode=OneWay}"/>
            </TextBlock>
          </StackPanel>
          <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="14" FontWeight="SemiBold" MinWidth="90"
                     TextAlignment="Right" VerticalAlignment="Center" Margin="16,0,16,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsFreed}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding SizeText}" Value="—">
                    <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <c:HelpTip Grid.Column="4" Text="{Binding Help}" Title="{Binding Name}"/>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="40,8,40,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="{l:T nav.cleanup}" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,18" TextWrapping="Wrap"
                 Text="{l:T cleanup.subtitle}"/>
    </StackPanel>

    <!-- Resumen -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22,16" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource BrandGradient}">
          <TextBlock Style="{StaticResource Icon}" Text="&#xEA99;" FontSize="20" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{l:T cleanup.recoverable}" Style="{StaticResource Caption}" FontSize="11.5" VerticalAlignment="Center"/>
            <c:HelpTip Width="18" Height="18" Margin="8,0,0,0" Text="{l:T cleanup.recoverable.help}"/>
          </StackPanel>
          <TextBlock Text="{Binding SelectedRecoverableText}" Style="{StaticResource BigNumber}" FontSize="26"/>
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
          <TextBlock Text="{Binding LastAnalysisText}" Foreground="{DynamicResource TextMuted}" FontSize="12.5" HorizontalAlignment="Right"/>
          <TextBlock Foreground="{DynamicResource TextDim}" FontSize="12" HorizontalAlignment="Right" Margin="0,2,0,0"
                     Text="{Binding SelectedCleanupCount, Mode=OneWay, Converter={StaticResource Plural}, ConverterParameter=cleanup.selectedCount}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Selección -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock Text="{l:T common.quickSelect}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12.5"/>
      <Button Style="{StaticResource PillButton}" Content="{l:T common.recommended}" Command="{Binding SelectCleanupPresetCommand}" CommandParameter="recommended"/>
      <Button Style="{StaticResource PillButton}" Content="{l:T common.all}" Command="{Binding SelectCleanupPresetCommand}" CommandParameter="all"/>
      <Button Style="{StaticResource PillButton}" Content="{l:T common.none}" Command="{Binding SelectCleanupPresetCommand}" CommandParameter="none"/>
      <c:HelpTip Margin="4,0,0,0" Text="{l:T cleanup.presets.help}"/>
    </StackPanel>

    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,10,0" Margin="0,0,-10,0">
      <ItemsControl ItemsSource="{Binding CleanupItems}" ItemTemplate="{StaticResource CleanRow}" Focusable="False" Margin="0,0,0,8"/>
    </ScrollViewer>

    <Border Grid.Row="4" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="0,16,0,20" Margin="0,4,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Command="{Binding AnalyzeCommand}" Margin="0,0,10,0" Padding="18,10">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13"/>
              <TextBlock Text="{l:T cleanup.analyze}" Margin="8,0,0,0"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource PrimaryButton}" Command="{Binding CleanCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xEA99;" FontSize="14" />
              <TextBlock Text="{Binding CleanButtonText}" Margin="10,0,0,0"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox IsChecked="{Binding AggressiveMode}" Content="{l:T cleanup.aggressive}"/>
          <c:HelpTip Margin="10,0,0,0" Text="{l:T cleanup.aggressive.help}" Title="{l:T cleanup.aggressive}"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
