<UserControl x:Class="Turbix.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Turbix.Controls"
             xmlns:l="clr-namespace:Turbix.Localization">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="40,8,40,32">

      <!-- Encabezado -->
      <TextBlock Text="{Binding Greeting}" Style="{StaticResource H1}"/>
      <TextBlock Text="{l:T home.subtitle}" Style="{StaticResource Muted}" Margin="0,4,0,22"/>

      <!-- Optimización rápida -->
      <Border CornerRadius="16" Background="{DynamicResource HeroGradient}" BorderBrush="{DynamicResource HeroBorder}"
              BorderThickness="1" Padding="28,24" ClipToBounds="True">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <!-- Marca de agua -->
          <ContentControl Grid.ColumnSpan="2" Template="{StaticResource MonogramOnly}" Foreground="{DynamicResource Watermark}" Width="240" Height="240"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-60,150,-60" Opacity="0.06"/>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{l:T home.quick.title}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"/>
              <c:HelpTip Margin="10,0,0,0" Text="{l:T home.quick.help}" Title="{l:T home.quick.title}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Muted}" Foreground="{DynamicResource HeroText}" Margin="0,8,0,16" MaxWidth="560" HorizontalAlignment="Left"
                       Text="{l:T home.quick.text}"/>
            <WrapPanel>
              <Border Style="{StaticResource Chip}" Background="{DynamicResource HeroChipBg}" Margin="0,0,8,0">
                <TextBlock FontSize="12" Foreground="{DynamicResource HeroChipText}"><Run FontFamily="{StaticResource IconFont}" Text="&#xE73E;"/><Run Text="  "/><Run Text="{l:T home.quick.chip.backup}"/></TextBlock>
              </Border>
              <Border Style="{StaticResource Chip}" Background="{DynamicResource HeroChipBg}" Margin="0,0,8,0">
                <TextBlock FontSize="12" Foreground="{DynamicResource HeroChipText}"><Run FontFamily="{StaticResource IconFont}" Text="&#xE73E;"/><Run Text="  "/><Run Text="{l:T home.quick.chip.restorePoint}"/></TextBlock>
              </Border>
              <Border Style="{StaticResource Chip}" Background="{DynamicResource HeroChipBg}">
                <TextBlock FontSize="12" Foreground="{DynamicResource HeroChipText}"><Run FontFamily="{StaticResource IconFont}" Text="&#xE73E;"/><Run Text="  "/><Run Text="{l:T home.quick.chip.safe}"/></TextBlock>
              </Border>
            </WrapPanel>
          </StackPanel>
          <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding QuickOptimizeCommand}"
                  VerticalAlignment="Center" Padding="26,13" Margin="24,0,0,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="15" />
              <TextBlock Text="{l:T home.quick.button}" FontSize="14.5" Margin="10,0,0,0"/>
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- Tarjetas de estado -->
      <Grid Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Privacidad -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel>
              <c:HelpTip DockPanel.Dock="Right" Text="{l:T home.privacy.help}" Title="{l:T nav.privacy}"/>
              <Border Style="{StaticResource IconTile}" Width="32" Height="32">
                <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="15" HorizontalAlignment="Center" Foreground="{DynamicResource AccentText}"/>
              </Border>
              <TextBlock Text="{l:T nav.privacy}" Style="{StaticResource H2}" Margin="12,0,8,0" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid Width="84" Height="84">
                <c:RingProgress Value="{Binding PrivacyScore}" Thickness="8" TrackBrush="{DynamicResource TrackBg}" Fill="{DynamicResource ProgressFill}"/>
                <TextBlock Text="{Binding PrivacyScoreText}" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding PrivacyLevel}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding PrivacySummary}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,2,0,8"/>
                <Button Style="{StaticResource LinkButton}" Command="{Binding NavigateCommand}" CommandParameter="privacy" HorizontalAlignment="Left">
                  <TextBlock FontSize="12.5" TextWrapping="Wrap"><Run Text="{l:T home.privacy.review}"/><Run Text=" "/><Run FontFamily="{StaticResource IconFont}" FontSize="10" Text="&#xE72A;"/></TextBlock>
                </Button>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Espacio recuperable -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel>
              <c:HelpTip DockPanel.Dock="Right" Text="{l:T home.space.help}" Title="{l:T home.space.title}"/>
              <Border Style="{StaticResource IconTile}" Width="32" Height="32">
                <TextBlock Style="{StaticResource Icon}" Text="&#xEA99;" FontSize="15" HorizontalAlignment="Center" Foreground="{DynamicResource AccentText}"/>
              </Border>
              <TextBlock Text="{l:T home.space.title}" Style="{StaticResource H2}" Margin="12,0,8,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
            <TextBlock Text="{Binding RecoverableText}" Style="{StaticResource BigNumber}" Margin="0,18,0,0"/>
            <TextBlock Text="{Binding LastAnalysisText}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="{l:T home.space.analyze}" Command="{Binding AnalyzeCommand}" Padding="14,6" FontSize="12.5"/>
              <Button Style="{StaticResource LinkButton}" Command="{Binding NavigateCommand}" CommandParameter="cleanup" Margin="14,0,0,0">
                <TextBlock FontSize="12.5" TextWrapping="Wrap"><Run Text="{l:T home.space.details}"/><Run Text=" "/><Run FontFamily="{StaticResource IconFont}" FontSize="10" Text="&#xE72A;"/></TextBlock>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Disco -->
        <Border Grid.Column="4" Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel>
              <c:HelpTip DockPanel.Dock="Right" Text="{l:T home.disk.help}" Title="{l:T home.disk.title}"/>
              <Border Style="{StaticResource IconTile}" Width="32" Height="32">
                <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" FontSize="15" HorizontalAlignment="Center" Foreground="{DynamicResource AccentText}"/>
              </Border>
              <TextBlock Text="{l:T home.disk.title}" Style="{StaticResource H2}" Margin="12,0,8,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
            <TextBlock Text="{Binding DiskFreeText}" Style="{StaticResource BigNumber}" Margin="0,18,0,0"/>
            <TextBlock Text="{Binding DiskDetail}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,0,0,14" TextWrapping="Wrap"/>
            <ProgressBar Value="{Binding DiskPercent, Mode=OneWay}" Maximum="100" Height="8"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Diagnóstico -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,20,22,8">
        <StackPanel>
          <DockPanel Margin="0,0,0,16">
            <c:HelpTip DockPanel.Dock="Right" Text="{l:T home.diag.help}" Title="{l:T home.diag.title}"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Command="{Binding RefreshDiagnosticsCommand}" Margin="0,0,14,0">
              <TextBlock FontSize="12.5" Text="{l:T home.diag.recheck}"/>
            </Button>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{l:T home.diag.title}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding DiagnosticsSummary}" Style="{StaticResource Muted}" FontSize="12.5" Margin="12,1,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Findings}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,0,0,14">
                  <Border Width="30" Height="30" CornerRadius="8" VerticalAlignment="Top" Margin="0,1,14,0">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource ChipNeutral}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding LevelKey}" Value="Ok"><Setter Property="Background" Value="{DynamicResource SuccessSoft}"/></DataTrigger>
                          <DataTrigger Binding="{Binding LevelKey}" Value="Warning"><Setter Property="Background" Value="{DynamicResource WarningSoft}"/></DataTrigger>
                          <DataTrigger Binding="{Binding LevelKey}" Value="Danger"><Setter Property="Background" Value="{DynamicResource DangerSoft}"/></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding LevelKey}" Value="Ok"><Setter Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
                            <DataTrigger Binding="{Binding LevelKey}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger>
                            <DataTrigger Binding="{Binding LevelKey}" Value="Danger"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Text}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,2,0,0"/>
                    <Button Style="{StaticResource LinkButton}" Command="{Binding ActionCommand}" HorizontalAlignment="Left" Margin="0,5,0,0"
                            Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}">
                      <TextBlock FontSize="12.5"><Run Text="{Binding ActionText, Mode=OneWay}"/><Run Text=" "/><Run FontFamily="{StaticResource IconFont}" FontSize="10" Text="&#xE72A;"/></TextBlock>
                    </Button>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Equipo -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,20">
        <StackPanel>
          <DockPanel Margin="0,0,0,18">
            <c:HelpTip DockPanel.Dock="Right" Text="{l:T home.pc.help}" Title="{l:T home.pc.title}"/>
            <TextBlock Text="{l:T home.pc.title}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
          </DockPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="32"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,18">
              <Border Style="{StaticResource IconTile}" Background="{DynamicResource Surface2}"><TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}"/></Border>
              <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{l:T home.pc.os}" Style="{StaticResource Caption}"/>
                <TextBlock Text="{Binding OsCaption}" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding OsVersion}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
              </StackPanel>
            </DockPanel>

            <DockPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,18">
              <Border Style="{StaticResource IconTile}" Background="{DynamicResource Surface2}"><TextBlock Style="{StaticResource Icon}" Text="&#xE950;" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}"/></Border>
              <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{l:T home.pc.cpu}" Style="{StaticResource Caption}"/>
                <TextBlock Text="{Binding CpuName}" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>

            <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,18">
              <Border Style="{StaticResource IconTile}" Background="{DynamicResource Surface2}"><TextBlock Style="{StaticResource Icon}" Text="&#xE964;" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}"/></Border>
              <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{l:T home.pc.ram}" Style="{StaticResource Caption}"/>
                <TextBlock Text="{Binding RamText}" FontWeight="SemiBold" Margin="0,2,0,6"/>
                <ProgressBar Value="{Binding RamPercent, Mode=OneWay}" Maximum="100" Height="5"/>
              </StackPanel>
            </DockPanel>

            <DockPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,18">
              <Border Style="{StaticResource IconTile}" Background="{DynamicResource Surface2}"><TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}"/></Border>
              <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{l:T home.pc.gpu}" Style="{StaticResource Caption}"/>
                <TextBlock Text="{Binding GpuName}" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>

            <DockPanel Grid.Row="2" Grid.Column="0">
              <Border Style="{StaticResource IconTile}" Background="{DynamicResource Surface2}"><TextBlock Style="{StaticResource Icon}" Text="&#xE770;" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}"/></Border>
              <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{l:T home.pc.user}" Style="{StaticResource Caption}"/>
                <TextBlock FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding ComputerName, Mode=OneWay}"/><Run Text="  ·  " Foreground="{DynamicResource TextDim}"/><Run Text="{Binding UserName, Mode=OneWay}"/>
                </TextBlock>
              </StackPanel>
            </DockPanel>

            <DockPanel Grid.Row="2" Grid.Column="2">
              <Border Style="{StaticResource IconTile}" Background="{DynamicResource Surface2}"><TextBlock Style="{StaticResource Icon}" Text="&#xE823;" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}"/></Border>
              <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{l:T home.pc.uptime}" Style="{StaticResource Caption}"/>
                <TextBlock Text="{Binding UptimeText}" FontWeight="SemiBold" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
