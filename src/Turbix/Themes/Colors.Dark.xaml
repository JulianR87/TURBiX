<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Paleta oscura. Colors.Dark.xaml y Colors.Light.xaml tienen las mismas claves:
       ThemeManager reemplaza un diccionario por el otro y la interfaz se actualiza sola. -->

  <!-- Base -->
  <SolidColorBrush x:Key="Bg" Color="#0C0E12"/>
  <SolidColorBrush x:Key="SidebarBg" Color="#101318"/>
  <SolidColorBrush x:Key="Surface" Color="#151920"/>
  <SolidColorBrush x:Key="SurfaceHover" Color="#1A1F28"/>
  <SolidColorBrush x:Key="Surface2" Color="#1E232D"/>
  <SolidColorBrush x:Key="Stroke" Color="#222834"/>
  <SolidColorBrush x:Key="StrokeStrong" Color="#2E3543"/>
  <SolidColorBrush x:Key="Text" Color="#ECEFF4"/>
  <SolidColorBrush x:Key="TextBody" Color="#C3CAD6"/>
  <SolidColorBrush x:Key="TextMuted" Color="#9AA4B5"/>
  <SolidColorBrush x:Key="TextDim" Color="#667085"/>
  <SolidColorBrush x:Key="Overlay" Color="#D90C0E12"/>

  <!-- Marca: lima sobre tinta -->
  <SolidColorBrush x:Key="Accent" Color="#C8F031"/>
  <SolidColorBrush x:Key="AccentHover" Color="#D7F865"/>
  <SolidColorBrush x:Key="AccentSoft" Color="#1D2412"/>
  <SolidColorBrush x:Key="AccentInk" Color="#12140F"/>
  <SolidColorBrush x:Key="AccentText" Color="#C8F031"/>
  <SolidColorBrush x:Key="AccentTextHover" Color="#E2FB8F"/>
  <SolidColorBrush x:Key="BrandGradient" Color="#C8F031"/>
  <SolidColorBrush x:Key="BrandGradientH" Color="#C8F031"/>
  <SolidColorBrush x:Key="ProgressFill" Color="#C8F031"/>
  <SolidColorBrush x:Key="TrackBg" Color="#232935"/>
  <SolidColorBrush x:Key="SpinnerTrack" Color="#2A3218"/>
  <SolidColorBrush x:Key="Watermark" Color="#C8F031"/>

  <!-- Bloques destacados y avisos -->
  <SolidColorBrush x:Key="HeroGradient" Color="#14170F"/>
  <SolidColorBrush x:Key="HeroBorder" Color="#2A3218"/>
  <SolidColorBrush x:Key="HeroText" Color="#B9BDB3"/>
  <SolidColorBrush x:Key="HeroTextDim" Color="#8E949C"/>
  <SolidColorBrush x:Key="HeroChipBg" Color="#1D2412"/>
  <SolidColorBrush x:Key="HeroChipText" Color="#D3EC8A"/>
  <SolidColorBrush x:Key="NoteBg" Color="#161A10"/>
  <SolidColorBrush x:Key="NoteStroke" Color="#2A3218"/>
  <SolidColorBrush x:Key="NoteText" Color="#C9D1B8"/>

  <!-- Estados -->
  <SolidColorBrush x:Key="Success" Color="#34D399"/>
  <SolidColorBrush x:Key="SuccessSoft" Color="#0E2B23"/>
  <SolidColorBrush x:Key="Warning" Color="#FBBF24"/>
  <SolidColorBrush x:Key="WarningSoft" Color="#2E2510"/>
  <SolidColorBrush x:Key="Danger" Color="#F87171"/>
  <SolidColorBrush x:Key="DangerSoft" Color="#33181B"/>
  <SolidColorBrush x:Key="ChipNeutral" Color="#1C212A"/>

  <!-- Controles -->
  <SolidColorBrush x:Key="ButtonHoverBg" Color="#262C38"/>
  <SolidColorBrush x:Key="ButtonHoverStroke" Color="#3A4252"/>
  <SolidColorBrush x:Key="ButtonPressedBg" Color="#1A1F28"/>
  <SolidColorBrush x:Key="ChromeHover" Color="#1F242E"/>
  <SolidColorBrush x:Key="NavHover" Color="#161A22"/>
  <SolidColorBrush x:Key="NavChecked" Color="#1A1E15"/>
  <SolidColorBrush x:Key="NavCheckedText" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="NavIndicator" Color="#C8F031"/>
  <SolidColorBrush x:Key="CheckStroke" Color="#4A5365"/>
  <SolidColorBrush x:Key="CheckFill" Color="#C8F031"/>
  <SolidColorBrush x:Key="CheckMark" Color="#12140F"/>
  <SolidColorBrush x:Key="HelpBg" Color="#1C212A"/>
  <SolidColorBrush x:Key="HelpStroke" Color="#343C4B"/>
  <SolidColorBrush x:Key="HelpText" Color="#8E98AA"/>
  <SolidColorBrush x:Key="HelpHoverText" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="TooltipBg" Color="#1D222C"/>
  <SolidColorBrush x:Key="TooltipStroke" Color="#353D4D"/>
  <SolidColorBrush x:Key="TooltipText" Color="#D5DAE3"/>
  <SolidColorBrush x:Key="ThumbBg" Color="#2A303C"/>
  <SolidColorBrush x:Key="ThumbHover" Color="#3B4352"/>
  <SolidColorBrush x:Key="ThumbDrag" Color="#4C5566"/>
  <SolidColorBrush x:Key="LogBg" Color="#090B0F"/>
  <SolidColorBrush x:Key="LogText" Color="#C9D0DB"/>
</ResourceDictionary>
